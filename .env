# RestaurantFNB local Docker environment
ASPNETCORE_ENVIRONMENT=Development

# MySQL
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword123!
MYSQL_DATABASE=restaurantfnb_master
MYSQL_USER=restaurantfnb_app
MYSQL_PASSWORD=ChangeThisAppPassword123!

# React/Vite build args
# Keep API relative for Telegram/ngrok Option B.
# Tenant/company are resolved by backend auth/session/claims.
VITE_API_BASE_URL=/api
VITE_TELEGRAM_BOT_USERNAME=@hotelnova_bot

# Hotelnova / RestaurantFNB frontend production build
# Keep API relative so the same HTTPS domain proxies /api to the backend.
# Tenant/company are resolved by backend auth/session/claims.
VITE_API_BASE_URL=/api
VITE_TELEGRAM_BOT_USERNAME=@hotelnova_bot
VITE_APP_NAME=Hotelnova ERP
VITE_APP_ENV=production